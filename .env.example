# LUME Security Environment Configuration
# Copy this file to .env and configure secrets if connecting to external LLM APIs

LUME_ENV=development
LUME_LOG_LEVEL=INFO

# Optional API keys for cloud LLM adapters
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CUSTOM_TARGET_API_KEY=

# Enterprise Key Service (required for external scans and testing agents)
# Point to a running instance of enterprise-key-service/ or your deployed Render URL
LUME_KEY_SERVICE_URL=http://localhost:8100
LUME_KEY_SERVICE_TIMEOUT=10

# Set to true to enforce Enterprise Key check for all scans including local testing agents
LUME_REQUIRE_ENTERPRISE_KEY=true

# Enterprise key for CLI (alternative to interactive prompt)
# Never commit a real key here; use interactive prompt or set per scan session
LUME_ENTERPRISE_KEY=
