# TravLume Enterprise Key Portal — environment configuration
# Copy this file to .env and fill in ALL values before running.
# Never commit .env or secrets to version control.

# ── Required ──────────────────────────────────────────────────────────────────

# Session & JWT signing secret — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
LUME_KS_SECRET_KEY=

# Audit log HMAC secret — must be DIFFERENT from LUME_KS_SECRET_KEY — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
LUME_KS_AUDIT_SECRET=

# Fernet encryption key for pending display keys — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED in production. Optional in development (falls back to plaintext with warning).
LUME_KS_ENCRYPTION_KEY=

# ── Database (Supabase) ────────────────────────────────────────────────────────
# Transaction pooler — use this for the running app (port 6543)
# Replace [YOUR-PASSWORD] with your actual Supabase database password
LUME_KS_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@<project-ref>.pooler.supabase.com:6543/postgres

# Session pooler — use this only for running migrations (port 5432)
# LUME_KS_MIGRATION_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@<region>.pooler.supabase.com:5432/postgres

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated. Use your real domain in production.
LUME_KS_ALLOWED_ORIGINS=http://localhost:8100

# ── Environment ────────────────────────────────────────────────────────────────
# Set to 'production' to enable HTTPS-only cookies and disable /docs
LUME_KS_ENV=development

# ── Token / session ────────────────────────────────────────────────────────────
LUME_KS_TOKEN_EXPIRE_SECONDS=28800

# ── Database connection pool (PostgreSQL only — ignored for SQLite) ───────────
# Tuned for Supabase free tier (~20 connection limit).
# Total max connections = POOL_SIZE + MAX_OVERFLOW
LUME_KS_DB_POOL_SIZE=3
LUME_KS_DB_MAX_OVERFLOW=7
LUME_KS_DB_POOL_TIMEOUT=30
LUME_KS_DB_POOL_RECYCLE=1800

# ── Reverse proxy trust ────────────────────────────────────────────────────────
# Controls whether X-Forwarded-For is trusted for rate-limit IP identification.
# Default: True in production (Render proxy is trusted), False in development.
# Set explicitly to override: true | false
# LUME_KS_TRUST_PROXY=true
#
# Number of trusted proxy hops between internet and this app.
# Default: 1 (Render's edge proxy only).
# If behind Render + Cloudflare (2 hops): set to 2.
# Rate limiter uses the N-th entry from the RIGHT of X-Forwarded-For,
# which is the entry appended by the last trusted proxy — not the leftmost,
# which an external client can forge.
# LUME_KS_PROXY_COUNT=1

# ── Isolated test database (CI only — NEVER set this to production) ───────────
# When set, PostgreSQL integration tests run against this URL.
# LUME_KS_TEST_PG_URL=postgresql://...
